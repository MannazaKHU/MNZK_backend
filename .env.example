
# Local defaults: no external API calls. Never commit .env.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Docker Compose overrides DATABASE_URL to use PostgreSQL.
# Direct Python execution can use SQLite without installing a DB server.
DATABASE_URL=sqlite:///./data/app.sqlite3
# Railway: use the Supabase Connect URI (Session pooler is an IPv4-compatible option).
# PostgreSQL URIs are normalized to postgresql+psycopg:// automatically.
# Supabase connections enforce sslmode=require or stronger.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT=10
# Generated by python3 scripts/setup_env.py (hex characters, URL-safe).
POSTGRES_PASSWORD=

# mock | chatkhu; copy the Base URL and model ID from your ChatKHU developer page.
AI_PROVIDER=mock
CHATKHU_API_KEY=
CHATKHU_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096

# mock | naver. Independent of AI_PROVIDER.
# Setup and explicit connection checks: docs/NAVER.md
MAPS_PROVIDER=mock
# NAVER API HUB local-search credentials (not developers.naver.com search keys).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCH_URL=https://naverapihub.apigw.ntruss.com/search/v1/local
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
NCP_MAPS_BASE=https://maps.apigw.ntruss.com
MAPS_TIMEOUT_SECONDS=10

# Optional official developers.naver.com Blog Search; NOT API Hub / NCP Maps keys.
ENABLE_BLOG_ENRICHMENT=false
NAVER_BLOG_CLIENT_ID=
NAVER_BLOG_CLIENT_SECRET=
BLOG_MAX_CANDIDATES=5
BLOG_QUERIES_PER_CANDIDATE=2
BLOG_RESULTS_PER_QUERY=5
BLOG_MAX_REQUESTS=10
BLOG_CONCURRENCY=3
BLOG_TIMEOUT_SECONDS=5
BLOG_EXTRACTION_TIMEOUT_SECONDS=20
# Temporary team policy: undated/future/older snippets are reference-only.
BLOG_MAX_AGE_DAYS=180

# Scope update: the NAVER_BLOG_* and search-call settings above are preserved API drafts.
# The active recommendation path does not import that client or use these credentials.
# It accepts team-supplied data through RecommendationInputs; extraction defaults to the existing AI adapter.
